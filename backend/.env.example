# ==============================================================================
# LexGuard Environment Configuration Template
# Copy this file to .env and configure your secrets.
# NEVER commit your actual .env file to source control.
# ==============================================================================

# Google Gemini API (Required for live Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Google Cloud Firestore & Firebase Auth
FIRESTORE_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
FIREBASE_AUTH_DISABLED_FOR_DEV=true

# Vector Store (Chroma)
CHROMA_PERSIST_DIR=./chroma_db

# Security & Limits
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=60
ENVIRONMENT=development
DEBUG=false
